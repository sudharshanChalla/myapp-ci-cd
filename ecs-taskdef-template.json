{
  "family": "myapp-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::779846785601:role/myapp-task-execution-role", 
  "containerDefinitions": [
    {
      "name": "myapp-container",
      "image": "IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048"
}
